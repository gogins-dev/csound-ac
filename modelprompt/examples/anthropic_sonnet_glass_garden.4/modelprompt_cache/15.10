instr Glass
PrintPfields
iamp = p4
ifreq = p5
aExc mpulse 1, 0
aNoise rand 1
aNzEnv expon 1, 0.01, 0.001
aEx = aExc + aNoise*aNzEnv
a1 reson aEx, ifreq*1.00, ifreq*1.00*0.004, 2
a2 reson aEx, ifreq*2.76, ifreq*2.76*0.005, 2
a3 reson aEx, ifreq*5.40, ifreq*5.40*0.006, 2
a4 reson aEx, ifreq*8.93, ifreq*8.93*0.007, 2
a5 reson aEx, ifreq*13.3, ifreq*13.3*0.008, 2
aSum = a1*1.0 + a2*0.5 + a3*0.25 + a4*0.12 + a5*0.05
kRing expon 1, p3, 0.001
aOut = aSum * kRing * iamp * 0.88
aLeft = aOut
aRight = aOut * 0.40
aRightDel delay aRight, 0.001
outleta "leftout", aLeft
outleta "rightout", aRightDel
endin

instr Pad
PrintPfields
iamp = p4
ifreq = p5
aOsc1 oscili iamp, ifreq*0.995
aOsc2 oscili iamp, ifreq*1.005
aOsc3 oscili iamp, ifreq*2
kEnv linen 1, 0.35*p3, p3, 0.35*p3
kDuck linseg 1, 115, 1, 10, 0.20, 33, 0.20, 16, 1, 66, 1
aLeft = aOsc1*0.6 + aOsc2*0.3 + aOsc3*0.1
aRight = aOsc1*0.3 + aOsc2*0.6 + aOsc3*0.1
aOutL = aLeft * kEnv * kDuck * 0.282
aOutR = aRight * kEnv * kDuck * 0.282
outleta "leftout", aOutL
outleta "rightout", aOutR
endin

instr Spark
PrintPfields
iamp = p4
ifreq = p5
aExc mpulse 1, 0
a1 reson aExc, ifreq*1.00, ifreq*1.00*0.002, 2
a2 reson aExc, ifreq*2.00, ifreq*2.00*0.002, 2
a3 reson aExc, ifreq*2.71, ifreq*2.71*0.003, 2
a4 reson aExc, ifreq*3.01, ifreq*3.01*0.003, 2
a5 reson aExc, ifreq*4.08, ifreq*4.08*0.004, 2
aSum = a1*1.0 + a2*0.9 + a3*0.5 + a4*0.4 + a5*0.25
iRingDur = (p3 > 2.2 ? p3 : 2.2)
kRing expon 1, iRingDur, 0.001
aOut = aSum * kRing * iamp * 1.76
aLeft = aOut*0.40
aRight = aOut
aRightDel delay aRight, 0.001
outleta "leftout", aLeft
outleta "rightout", aRightDel
endin

instr Pulse
PrintPfields
iamp = p4
ifreq = p5
aSig vco2 iamp, ifreq*0.5, 2, 0.18
aFilt butlp aSig, ifreq*2.8
aEnv linen 1, 0.03, p3, 0.07
kRaw lfo 0.5, 4, 3
kUni = 0.5 + kRaw
kGate port kUni, 0.018
kDuck linseg 1, 115, 1, 10, 0.20, 33, 0.20, 16, 1, 66, 1
aOut = aFilt * aEnv * kGate * kDuck * 0.062
aLeft = aOut*0.45
aRight = aOut*0.55
outleta "leftout", aLeft
outleta "rightout", aRight
endin

instr Echo
PrintPfields
aLeftIn inleta "leftin"
aRightIn inleta "rightin"
kLeft linseg 680, 80, 620, 80, 210, 80, 960
kRight linseg 360, 80, 450, 80, 820, 80, 280
kWet linseg 0.70, 80, 0.64, 80, 0.34, 80, 0.66
kFb linseg 0.88, 80, 0.84, 80, 0.76, 80, 0.90
aLfb init 0
aLdel vdelay aLeftIn + aLfb*kFb, kLeft, 2000
aLfb = aLdel
aRfb init 0
aRdel vdelay aRightIn + aRfb*kFb, kRight, 2000
aRfb = aRdel
aLout = aLeftIn*(1-kWet) + aLdel*kWet
aRout = aRightIn*(1-kWet) + aRdel*kWet
outleta "leftout", aLout
outleta "rightout", aRout
endin

instr Reverb
PrintPfields
aLeftIn inleta "leftin"
aRightIn inleta "rightin"
aRevL, aRevR reverbsc aLeftIn, aRightIn, 0.90, 12000
kWet = 0.42
aOutL = aLeftIn*(1-kWet) + aRevL*kWet
aOutR = aRightIn*(1-kWet) + aRevR*kWet
outleta "leftout", aOutL
outleta "rightout", aOutR
endin

instr Master
PrintPfields
aLeftIn inleta "leftin"
aRightIn inleta "rightin"
kfade linseg 1, 222, 1, 18, 0
aOutL = tanh(aLeftIn*4) * 2.8 * kfade
aOutR = tanh(aRightIn*4) * 2.8 * kfade
outc aOutL, aOutR
endin

connect "Glass", "leftout", "Echo", "leftin"
connect "Glass", "rightout", "Echo", "rightin"
connect "Spark", "leftout", "Echo", "leftin"
connect "Spark", "rightout", "Echo", "rightin"
connect "Pulse", "leftout", "Reverb", "leftin"
connect "Pulse", "rightout", "Reverb", "rightin"
connect "Pad", "leftout", "Reverb", "leftin"
connect "Pad", "rightout", "Reverb", "rightin"
connect "Echo", "leftout", "Reverb", "leftin"
connect "Echo", "rightout", "Reverb", "rightin"
connect "Reverb", "leftout", "Master", "leftin"
connect "Reverb", "rightout", "Master", "rightin"

alwayson "Echo"
alwayson "Reverb"
alwayson "Master"