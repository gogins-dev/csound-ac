instr Glass
PrintPfields
iamp = p4
ifreq = p5
aExc mpulse 1, 0
aNz rand iamp
kNzEnv expon 1, 0.01, 0.001
aNoise = aNz * kNzEnv
aSrc = aExc + aNoise
kAmpEnv expon iamp, p3, iamp*0.001
a1 reson aSrc, ifreq*1.00, ifreq*1.00*0.003, 2
a2 reson aSrc, ifreq*2.76, ifreq*2.76*0.004, 2
a3 reson aSrc, ifreq*5.40, ifreq*5.40*0.005, 2
a4 reson aSrc, ifreq*8.93, ifreq*8.93*0.006, 2
a5 reson aSrc, ifreq*13.3, ifreq*13.3*0.007, 2
aSum = a1*1.0 + a2*0.6 + a3*0.35 + a4*0.15 + a5*0.05
aSum = aSum * kAmpEnv
aSum = aSum * 0.88
aLeft = aSum
aRight delay aSum*0.40, 0.0011
outleta "leftout", aLeft
outleta "rightout", aRight
endin

instr Pad
PrintPfields
iamp = p4
ifreq = p5
aOsc1 oscili iamp, ifreq*0.995
aOsc2 oscili iamp, ifreq*1.005
aOsc3 oscili iamp, ifreq*2
kEnv linen 1, p3*0.35, p3, p3*0.35
kDuck linseg 1, 115, 1, 10, 0.20, 33, 0.20, 16, 1, 66, 1
aL = aOsc1*0.6 + aOsc2*0.3 + aOsc3*0.1
aR = aOsc1*0.3 + aOsc2*0.6 + aOsc3*0.1
aPadL = aL * kEnv * kDuck * 0.355
aPadR = aR * kEnv * kDuck * 0.355
outleta "leftout", aPadL
outleta "rightout", aPadR
endin

instr Spark
PrintPfields
iamp = p4
ifreq = p5
aExc mpulse 1, 0
idur = (p3 > 2.2 ? p3 : 2.2)
kAmpEnv expon iamp, idur, iamp*0.001
a1 reson aExc, ifreq*0.50, ifreq*0.50*0.002, 2
a2 reson aExc, ifreq*1.00, ifreq*1.00*0.0025, 2
a3 reson aExc, ifreq*1.20, ifreq*1.20*0.003, 2
a4 reson aExc, ifreq*1.50, ifreq*1.50*0.0035, 2
a5 reson aExc, ifreq*2.00, ifreq*2.00*0.004, 2
aSum = a1*0.35 + a2*1.0 + a3*0.55 + a4*0.35 + a5*0.22
aSum = aSum * kAmpEnv
aSum = aSum * 1.24
aLeft = aSum * 0.40
aRight delay aSum, 0.0013
outleta "leftout", aLeft
outleta "rightout", aRight
endin

instr Pulse
PrintPfields
iamp = p4
ifreq = p5
aSig vco2 iamp, ifreq*0.5, 2, 0.18
aFil butlp aSig, ifreq*2.8
aEnv linen 1, 0.03, p3, 0.07
kRaw lfo 0.5, 4, 3
kUni = 0.5 + kRaw
kGate port kUni, 0.018
kDuck linseg 1, 115, 1, 10, 0.20, 33, 0.20, 16, 1, 66, 1
aOut = aFil * aEnv * kGate * kDuck * 0.062
aPulseL = aOut * 0.9
aPulseR = aOut * 1.0
outleta "leftout", aPulseL
outleta "rightout", aPulseR
endin

instr Echo
PrintPfields
aLeftIn inleta "leftin"
aRightIn inleta "rightin"
kLeft linseg 1200, 70, 1200, 10, 180, 70, 180, 10, 1500, 80, 1500
kRight linseg 480, 70, 480, 10, 860, 70, 860, 10, 260, 80, 260
kWet linseg 0.78, 70, 0.78, 10, 0.45, 70, 0.45, 10, 0.70, 80, 0.70
kFb linseg 0.94, 70, 0.94, 10, 0.58, 70, 0.58, 10, 0.80, 80, 0.80
aLfb init 0
aRfb init 0
aLdel vdelay aLeftIn + aLfb * kFb, kLeft, 2000
aLfb = aLdel
aRdel vdelay aRightIn + aRfb * kFb, kRight, 2000
aRfb = aRdel
aLout = aLeftIn * (1 - kWet) + aLdel * kWet
aRout = aRightIn * (1 - kWet) + aRdel * kWet
outleta "leftout", aLout
outleta "rightout", aRout
endin

instr Reverb
PrintPfields
aLeftIn inleta "leftin"
aRightIn inleta "rightin"
aRevL, aRevR reverbsc aLeftIn, aRightIn, 0.90, 12000
kWet = 0.42
aOutL = aLeftIn * (1 - kWet) + aRevL * kWet
aOutR = aRightIn * (1 - kWet) + aRevR * kWet
outleta "leftout", aOutL
outleta "rightout", aOutR
endin

instr Master
PrintPfields
aLeftIn inleta "leftin"
aRightIn inleta "rightin"
kfade linseg 1, 222, 1, 18, 0
aOutL = tanh(aLeftIn * 4) * 2.0 * kfade
aOutR = tanh(aRightIn * 4) * 2.0 * kfade
outc aOutL, aOutR
endin

connect "Glass", "leftout", "Echo", "leftin"
connect "Glass", "rightout", "Echo", "rightin"
connect "Spark", "leftout", "Echo", "leftin"
connect "Spark", "rightout", "Echo", "rightin"
connect "Pulse", "leftout", "Reverb", "leftin"
connect "Pulse", "rightout", "Reverb", "rightin"
connect "Pad", "leftout", "Reverb", "leftin"
connect "Pad", "rightout", "Reverb", "rightin"
connect "Echo", "leftout", "Reverb", "leftin"
connect "Echo", "rightout", "Reverb", "rightin"
connect "Reverb", "leftout", "Master", "leftin"
connect "Reverb", "rightout", "Master", "rightin"

alwayson "Echo"
alwayson "Reverb"
alwayson "Master"