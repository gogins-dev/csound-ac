instr Glass
PrintPfields
iamp = p4
ifreq = p5
aExcite mpulse 1, 0
aNoise noise 1, 0
kNoiseEnv expon 1, 0.01, 0.001
aNoiseBurst = aNoise * kNoiseEnv
aSrc = aExcite + aNoiseBurst

aP1 reson aSrc, ifreq*1.00, ifreq*1.00*0.003, 2
aP2 reson aSrc, ifreq*2.76, ifreq*2.76*0.004, 2
aP3 reson aSrc, ifreq*5.40, ifreq*5.40*0.005, 2
aP4 reson aSrc, ifreq*8.93, ifreq*8.93*0.006, 2
aP5 reson aSrc, ifreq*13.3, ifreq*13.3*0.007, 2

kEnv expon 1, p3, 0.001
aSum = (aP1*1.0 + aP2*0.4 + aP3*0.2 + aP4*0.1 + aP5*0.05) * kEnv
aSum = aSum * iamp * 0.88

aLeft = aSum
aRightDel delay aSum, 0.001
aRight = aRightDel * 0.40

outleta "leftout", aLeft
outleta "rightout", aRight
endin

instr Pad
PrintPfields
iamp = p4
ifreq = p5
aOsc1 oscili iamp, ifreq*0.99
aOsc2 oscili iamp, ifreq*1.01
aOsc3 oscili iamp, ifreq*2

kEnv linen 1, p3*0.35, p3, p3*0.35
kDuck linseg 1, 115, 1, 10, 0.20, 33, 0.20, 16, 1, 66, 1

aLeft = (aOsc1*0.6 + aOsc3*0.4) * kEnv * kDuck * 0.282
aRight = (aOsc2*0.6 + aOsc3*0.4) * kEnv * kDuck * 0.282

outleta "leftout", aLeft
outleta "rightout", aRight
endin

instr Spark
PrintPfields
iamp = p4
ifreq = p5
aExcite mpulse 1, 0

aP1 reson aExcite, ifreq*1.00, ifreq*1.00*0.002, 2
aP2 reson aExcite, ifreq*2.00, ifreq*2.00*0.002, 2
aP3 reson aExcite, ifreq*2.71, ifreq*2.71*0.003, 2
aP4 reson aExcite, ifreq*3.01, ifreq*3.01*0.003, 2
aP5 reson aExcite, ifreq*4.08, ifreq*4.08*0.004, 2

idur = p3
if p3 < 2.2 then
idur = 2.2
endif

kEnv expon 1, idur, 0.001
aSum = (aP1*1.0 + aP2*0.9 + aP3*0.5 + aP4*0.4 + aP5*0.3) * kEnv
aSum = aSum * iamp * 1.76

aLeft = aSum * 0.40
aRightDel delay aSum, 0.001
aRight = aRightDel

outleta "leftout", aLeft
outleta "rightout", aRight
endin

instr Pulse
PrintPfields
iamp = p4
ifreq = p5
aSig vco2 iamp, ifreq*0.5, 2, 0.18
aFilt butlp aSig, ifreq*2.8

kGate lfo 1, 4, 3
kEnv linen 1, 0.012, p3, 0.05
kDuck linseg 1, 115, 1, 10, 0.20, 33, 0.20, 16, 1, 66, 1

aOut = aFilt * kGate * kEnv * kDuck * 0.062

aLeft = aOut * 0.9
aRight = aOut * 1.1

outleta "leftout", aLeft
outleta "rightout", aRight
endin

instr Echo
PrintPfields
aLeftIn inleta "leftin"
aRightIn inleta "rightin"

kLeft linseg 680, 80, 620, 80, 210, 80, 960
kRight linseg 360, 80, 450, 80, 820, 80, 280
kWet linseg 0.70, 80, 0.64, 80, 0.34, 80, 0.66
kFb linseg 0.88, 80, 0.84, 80, 0.76, 80, 0.90

aLfb init 0
aRfb init 0

aLdel vdelay aLeftIn + aLfb * kFb, kLeft, 2000
aLfb = aLdel

aRdel vdelay aRightIn + aRfb * kFb, kRight, 2000
aRfb = aRdel

aLout = aLeftIn * (1 - kWet) + aLdel * kWet
aRout = aRightIn * (1 - kWet) + aRdel * kWet

outleta "leftout", aLout
outleta "rightout", aRout
endin

instr Reverb
PrintPfields
aLeftIn inleta "leftin"
aRightIn inleta "rightin"

aRevL, aRevR reverbsc aLeftIn, aRightIn, 0.90, 12000

kWet = 0.42
aOutL = aLeftIn * (1 - kWet) + aRevL * kWet
aOutR = aRightIn * (1 - kWet) + aRevR * kWet

outleta "leftout", aOutL
outleta "rightout", aOutR
endin

instr Master
PrintPfields
aLeftIn inleta "leftin"
aRightIn inleta "rightin"

kfade linseg 1, 222, 1, 18, 0

aOutL = tanh(aLeftIn*4) * kfade
aOutR = tanh(aRightIn*4) * kfade

outc aOutL, aOutR
endin

connect "Glass", "leftout", "Echo", "leftin"
connect "Glass", "rightout", "Echo", "rightin"
connect "Spark", "leftout", "Echo", "leftin"
connect "Spark", "rightout", "Echo", "rightin"
connect "Pulse", "leftout", "Reverb", "leftin"
connect "Pulse", "rightout", "Reverb", "rightin"
connect "Pad", "leftout", "Reverb", "leftin"
connect "Pad", "rightout", "Reverb", "rightin"
connect "Echo", "leftout", "Reverb", "leftin"
connect "Echo", "rightout", "Reverb", "rightin"
connect "Reverb", "leftout", "Master", "leftin"
connect "Reverb", "rightout", "Master", "rightin"

alwayson "Echo"
alwayson "Reverb"
alwayson "Master"