instr Glass
PrintPfields
iamp = p4
ifreq = p5
aPulse mpulse 1, 0
aNoise noise 1, 0
aNoiseEnv expon 1, 0.01, 0.001
aExcite = aPulse + aNoise*aNoiseEnv
aPar1 reson aExcite, ifreq*1.00, ifreq*1.00*0.004, 2
aPar2 reson aExcite, ifreq*2.76, ifreq*2.76*0.006, 2
aPar3 reson aExcite, ifreq*5.40, ifreq*5.40*0.008, 2
aPar4 reson aExcite, ifreq*8.93, ifreq*8.93*0.010, 2
aPar5 reson aExcite, ifreq*13.3, ifreq*13.3*0.012, 2
aMix = aPar1*1.0 + aPar2*0.4 + aPar3*0.15 + aPar4*0.08 + aPar5*0.05
aRing expon 1, p3, 0.001
aGlassOut = aMix * aRing * 0.88
aGlassRight delay aGlassOut*0.40, 0.001
outleta "leftout", aGlassOut
outleta "rightout", aGlassRight
endin

instr Pad
PrintPfields
iamp = p4
ifreq = p5
aOsc1 oscili iamp, ifreq*0.995
aOsc2 oscili iamp, ifreq*1.005
aOsc3 oscili iamp, ifreq*2
kEnv linen 1, p3*0.35, p3, p3*0.35
kDuck linseg 1, 115, 1, 10, 0.20, 33, 0.20, 16, 1, 66, 1
aPadLeftMix = aOsc1*0.6 + aOsc3*0.4
aPadRightMix = aOsc2*0.6 + aOsc3*0.4
aPadL = aPadLeftMix * kEnv * kDuck * 0.355
aPadR = aPadRightMix * kEnv * kDuck * 0.355
outleta "leftout", aPadL
outleta "rightout", aPadR
endin

instr Spark
PrintPfields
iamp = p4
ifreq = p5
icos ftgenonce 0, 0, 65537, 11, 1
xtratim 6
aTone fmbell 1, ifreq, 0.5, 0.5, 0.05, 6, icos, icos, icos, icos, icos
aEnv transeg 0, 0.002, 6, 1, 6, -6, 0
aBell = aTone * aEnv * iamp * 2.47
aSparkLeft = aBell*0.40
aSparkRight delay aBell, 0.001
outleta "leftout", aSparkLeft
outleta "rightout", aSparkRight
endin

instr Pulse
PrintPfields
iamp = p4
ifreq = p5
aSig vco2 iamp, ifreq*0.5, 2, 0.18
aFilt butlp aSig, ifreq*2.8
kRaw lfo 0.5, 4, 3
kUni = 0.5 + kRaw
kGate port kUni, 0.018
aEnv linen 1, 0.03, p3, 0.07
kDuck linseg 1, 115, 1, 10, 0.20, 33, 0.20, 16, 1, 66, 1
aPulseOut = aFilt * kGate * aEnv * kDuck * 0.035
aPulseLeft = aPulseOut*0.9
aPulseRight = aPulseOut*1.0
outleta "leftout", aPulseLeft
outleta "rightout", aPulseRight
endin

instr Echo
PrintPfields
aLeftIn inleta "leftin"
aRightIn inleta "rightin"
kLeft linseg 1200, 70, 1200, 10, 180, 70, 180, 10, 1500, 80, 1500
kRight linseg 480, 70, 480, 10, 860, 70, 860, 10, 260, 80, 260
kWet linseg 0.78, 70, 0.78, 10, 0.45, 70, 0.45, 10, 0.70, 80, 0.70
kFb linseg 0.94, 70, 0.94, 10, 0.58, 70, 0.58, 10, 0.80, 80, 0.80
aLfb init 0
aLdel vdelay aLeftIn + aLfb*kFb, kLeft, 2000
aLfb = aLdel
aRfb init 0
aRdel vdelay aRightIn + aRfb*kFb, kRight, 2000
aRfb = aRdel
aLout = aLeftIn*(1-kWet) + aLdel*kWet
aRout = aRightIn*(1-kWet) + aRdel*kWet
outleta "leftout", aLout
outleta "rightout", aRout
endin

instr Reverb
PrintPfields
aLeftIn inleta "leftin"
aRightIn inleta "rightin"
aRevL, aRevR reverbsc aLeftIn, aRightIn, 0.90, 12000
aOutL = aLeftIn*(1-0.42) + aRevL*0.42
aOutR = aRightIn*(1-0.42) + aRevR*0.42
outleta "leftout", aOutL
outleta "rightout", aOutR
endin

instr Master
PrintPfields
aLeftIn inleta "leftin"
aRightIn inleta "rightin"
kfade linseg 1, 222, 1, 18, 0
aOutL = tanh(aLeftIn * 4) * 2.0 * kfade
aOutR = tanh(aRightIn * 4) * 2.0 * kfade
outc aOutL, aOutR
endin

connect "Glass", "leftout", "Echo", "leftin"
connect "Glass", "rightout", "Echo", "rightin"
connect "Spark", "leftout", "Echo", "leftin"
connect "Spark", "rightout", "Echo", "rightin"
connect "Pulse", "leftout", "Reverb", "leftin"
connect "Pulse", "rightout", "Reverb", "rightin"
connect "Pad", "leftout", "Reverb", "leftin"
connect "Pad", "rightout", "Reverb", "rightin"
connect "Echo", "leftout", "Reverb", "leftin"
connect "Echo", "rightout", "Reverb", "rightin"
connect "Reverb", "leftout", "Master", "leftin"
connect "Reverb", "rightout", "Master", "rightin"

alwayson "Echo"
alwayson "Reverb"
alwayson "Master"